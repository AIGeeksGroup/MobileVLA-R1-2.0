include README.md LICENSE NOTICE CONTRIBUTING.md SECURITY.md
recursive-include configs *.yaml
recursive-include docs *.md
recursive-include examples *.jsonl
recursive-include scripts *.py *.sh
recursive-include tests *.py
prune checkpoints
prune outputs
prune data
prune .venv
prune .git
prune .codex
prune .agents
global-exclude *.py[cod] .DS_Store .env *.pt *.pth *.bin *.safetensors *.pem *.key
